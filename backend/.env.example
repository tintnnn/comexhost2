# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# When you deploy frontend and backend on different hosts, list every
# allowed origin here, comma-separated. NEVER use "*" together with
# CORS_CREDENTIALS=true (the browser will reject it).
#
# Examples:
#   CORS_ORIGIN=http://localhost:4200
#   CORS_ORIGIN=https://comex.example.com,https://staging.comex.example.com
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=false

# Set to 1 (or "true") when running behind a reverse proxy / load balancer
# (Heroku, Render, Nginx, Cloudflare, etc.) so req.ip + rate limiting work.
TRUST_PROXY=0

# ---------------------------------------------------------------
# PostgreSQL (Supabase Database)
# ---------------------------------------------------------------
# Project Settings → Database → Connection string
# - Local db:init / db:seed: use Direct connection (port 5432)
# - Vercel production: use Transaction pooler (port 6543) and append ?sslmode=require
DATABASE_URL=postgres://postgres:password@db.xyz.supabase.co:5432/postgres

# If not using DATABASE_URL, you can use the following:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_CONNECTION_LIMIT=10

# Required true for Supabase (and most hosted Postgres)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ---------------------------------------------------------------
# Supabase Storage
# ---------------------------------------------------------------
# Project Settings → API
# SUPABASE_KEY must be the service_role secret (backend only, never in the frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-service-role-secret
SUPABASE_BUCKET=comex-documents

# ---------------------------------------------------------------
# Auth (REQUIRED in production)
# ---------------------------------------------------------------
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server REFUSES to start if this is missing or weak (<32 chars).
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=comex-approval-api
JWT_AUDIENCE=comex-approval-app
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------
# Seed admin (used by `npm run db:seed`)
# ---------------------------------------------------------------
SEED_ADMIN_NAME=Principal Admin
SEED_ADMIN_EMAIL=admin@comex.local
SEED_ADMIN_PASSWORD=Admin@12345
